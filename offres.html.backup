              doc.text("Transport", colX[3]+2, y+3);
              doc.text("Traitement/tonne", colX[4]+2, y+3);
              y += 7;
              
              doc.rect(15, y, 180, 8);
              doc.setFont("helvetica", "normal");
              doc.text("Conteneur", colX[0]+2, y+5);
              doc.text((ligne.dechet || "-").substring(0, 15), colX[1]+2, y+5);
              doc.text(ligne.volume || "-", colX[2]+2, y+5);
              doc.text(`${ligne.poidsTransport || "0"} EUR`, colX[3]+2, y+5);
              doc.text(`${ligne.poidsTarif || "0"} EUR/T`, colX[4]+2, y+5);
              y += 10;
            }
          }
          else if(ligne.type === "bigbag"){
            const colX = [15, 70, 130];
            
            doc.setFont("helvetica", "bold");
            doc.rect(15, y-3, 180, 10);
            doc.text("Type", colX[0]+2, y+3);
            doc.text("Dechet", colX[1]+2, y+3);
            doc.text("Cout unitaire", colX[2]+2, y+3);
            y += 7;
            
            doc.rect(15, y, 180, 8);
            doc.setFont("helvetica", "normal");
            doc.text("Big Bag", colX[0]+2, y+5);
            doc.text((ligne.dechet || "-").substring(0, 30), colX[1]+2, y+5);
            doc.text(`${ligne.cost || "0"} EUR`, colX[2]+2, y+5);
            y += 10;
          }
          else if(ligne.type === "sac"){
            const colX = [15, 60, 120, 160];
            
            doc.setFont("helvetica", "bold");
            doc.rect(15, y-3, 180, 10);
            doc.text("Type", colX[0]+2, y+3);
            doc.text("Dechet", colX[1]+2, y+3);
            doc.text("Cout unitaire", colX[2]+2, y+3);
            doc.text("Max", colX[3]+2, y+3);
            y += 7;
            
            doc.rect(15, y, 180, 8);
            doc.setFont("helvetica", "normal");
            doc.text("Sac", colX[0]+2, y+5);
            doc.text((ligne.dechet || "-").substring(0, 25), colX[1]+2, y+5);
            doc.text(`${ligne.cost || "0"} EUR`, colX[2]+2, y+5);
            doc.text(`${ligne.max || "0"} kg`, colX[3]+2, y+5);
            y += 10;
          }
          else {
            // Autres types avec bordures
            const colX = [15, 70, 130];
            
            doc.setFont("helvetica", "bold");
            doc.rect(15, y-3, 180, 10);
            doc.text("Type", colX[0]+2, y+3);
            doc.text("Dechet", colX[1]+2, y+3);
            doc.text("Cout unitaire", colX[2]+2, y+3);
            y += 7;
            
            doc.rect(15, y, 180, 8);
            doc.setFont("helvetica", "normal");
            doc.text(ligne.type || "-", colX[0]+2, y+5);
            doc.text((ligne.dechet || "-").substring(0, 30), colX[1]+2, y+5);
            doc.text(`${ligne.cost || "0"} EUR`, colX[2]+2, y+5);
            y += 10;
