            doc.rect(15, y, 180, 8);
            doc.setFont("helvetica", "normal");
            doc.text("Poubelle", colX[0]+2, y+5);
            doc.text((ligne.dechet || "-").substring(0, 10), colX[1]+2, y+5);
            doc.text(ligne.modele || "-", colX[2]+2, y+5);
            doc.text(ligne.nombre || "-", colX[3]+2, y+5);
            doc.text(`${ligne.loc || "0"} EUR`, colX[4]+2, y+5);
            doc.text(`${ligne.vidange || "0"} EUR`, colX[5]+2, y+5);
            doc.text(`${ligne.max || "0"} kg`, colX[6]+2, y+5);
            doc.text(`${ligne.surpoids || "0"} EUR/kg`, colX[7]+2, y+5);
            y += 10;
          }
          else if(ligne.type === "conteneur"){
            if(ligne.mode === "forfait"){
              // Conteneur en forfait avec bordures
              const colX = [15, 40, 60, 80, 105, 135, 165];
              
