              doc.text(`${ligne.forfaitSurpoids || "0"} EUR/kg`, colX[6]+2, y+5);
              y += 10;
            } else {
              // Conteneur au poids avec bordures
              const colX = [15, 50, 80, 110, 150];
              
              doc.setFont("helvetica", "bold");
              doc.rect(15, y-3, 180, 10);
              doc.text("Type", colX[0]+2, y+3);
