              doc.rect(15, y-3, 180, 10);
              doc.text("Type", colX[0]+2, y+3);
              doc.text("Dechet", colX[1]+2, y+3);
              doc.text("Taille", colX[2]+2, y+3);
              doc.text("Forfait", colX[3]+2, y+3);
              doc.text("Location", colX[4]+2, y+3);
              doc.text("Max", colX[5]+2, y+3);
