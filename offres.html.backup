        doc.text("Signature Transmosca:", 20, y);
        doc.text("Signature Client:", 130, y);
        y += 10;
        doc.setFont("helvetica", "normal");
        doc.text("Vincent Cousin", 20, y);
        doc.text("Date:", 130, y);
        y += 5;
        doc.text("Sales Manager", 20, y);

        doc.save(`Offre_${offer.offerNumber.replace(/\//g, "_")}.pdf`);
      }

      function createContractFromOffer(offer){
        if(!confirm("Transformer cette offre en contrat signe ?")) return;
        
        const duree = offer.dureeContrat || prompt("Duree du contrat en mois (12, 24, 36, 48, 60):", "12");
        if(!duree) return;

        const contracts = readContracts();
        const contractNum = makeContractNumberFromOfferNum(offer.offerNumber);
        
        const contract = {
          ...offer,
          contractNumber: contractNum,
          signedDate: new Date().toLocaleDateString("fr-FR"),
          dureeContrat: duree,
          status: "actif"
        };
        
        contracts.push(contract);
        writeContracts(contracts);

        // Ajouter au CA si durée spécifiée
        if(duree){
          const results = readResults();
          let totalCA = 0;
          
          offer.lignes.forEach(ligne => {
            if(ligne.type === "poubelle"){
              const loc = parseFloat(ligne.loc) || 0;
              totalCA += loc * parseInt(duree);
            } else if(ligne.type === "conteneur"){
              if(ligne.mode === "forfait"){
                const loc = parseFloat(ligne.forfaitLoc) || 0;
                totalCA += loc * parseInt(duree);
              } else {
                const loc = parseFloat(ligne.poidsLoc) || 0;
                totalCA += loc * parseInt(duree);
              }
            }
          });

          results.push({
            id: crypto.randomUUID(),
            date: new Date().toLocaleDateString("fr-FR"),
            contractNumber: contractNum,
            client: offer.clientName,
            etablissement: offer.etablissement || "",
            duree: parseInt(duree),
            montantTotal: totalCA,
            year: new Date().getFullYear()
          });
          
          writeResults(results);
        }

        alert("Contrat cree : " + contractNum + "\nAjoute aux resultats CA");
        renderOffers();
      }

      function renderOffers(searchTerm = ""){
        const offers = readOffers();
        if(!offers.length){
          offresEl.innerHTML = '<p class="muted">Aucune offre enregistree.</p>';
          return;
        }

        // Filtrer les offres selon le terme de recherche
        const filtered = searchTerm ? offers.filter(o => {
          const term = searchTerm.toLowerCase();
          return (o.clientName && o.clientName.toLowerCase().includes(term)) ||
                 (o.etablissement && o.etablissement.toLowerCase().includes(term)) ||
                 (o.tva && o.tva.toLowerCase().includes(term)) ||
                 (o.adresse && o.adresse.toLowerCase().includes(term)) ||
                 (o.adressePresta && o.adressePresta.toLowerCase().includes(term)) ||
                 (o.offerNumber && o.offerNumber.toLowerCase().includes(term));
        }) : offers;

        if(!filtered.length){
          offresEl.innerHTML = '<p class="muted">Aucune offre trouvee pour cette recherche.</p>';
          return;
        }

        offresEl.innerHTML = filtered.map(o => `
          <div class="offer">
            <h4>${escapeHtml(o.clientName)}<span class="badge">${escapeHtml(o.clientType)}</span></h4>
            <div class="muted">
              ${o.etablissement ? `<strong>${escapeHtml(o.etablissement)}</strong><br>` : ''}
              ${o.tva ? `TVA: ${escapeHtml(o.tva)}<br>` : ''}
              ${o.adresse ? `Adresse: ${escapeHtml(o.adresse)}<br>` : ''}
              Offre : <strong>${escapeHtml(o.offerNumber)}</strong> | 
              Date : ${escapeHtml(o.date)} | 
              ${o.lignes.length} ligne(s)
              ${o.dureeContrat ? ` | Duree: ${o.dureeContrat} mois` : ''}
            </div>
            <div class="actions">
              <button class="info" onclick='editOffer("${o.id}")'>✏️ Modifier</button>
              <button class="warning" onclick='previewOffer(${JSON.stringify(o).replace(/'/g, "&#39;")})'>👁️ Visualiser</button>
              <button class="export" onclick='exportPDF(${JSON.stringify(o).replace(/'/g, "&#39;")})'>📄 Export PDF</button>
              <button class="save" onclick='createContractFromOffer(${JSON.stringify(o).replace(/'/g, "&#39;")})'>✅ Creer contrat</button>
              <button class="danger" onclick='deleteOffer("${o.id}")'>🗑️ Supprimer</button>
            </div>
          </div>
        `).join('');
      }

      window.exportPDF = exportPDF;
      window.createContractFromOffer = createContractFromOffer;
      window.deleteOffer = deleteOffer;
      window.editOffer = editOffer;
      window.previewOffer = previewOffer;
      window.exportData = exportData;
      window.importData = importData;

      function exportData(){
        const data = {
          offres: readOffers(),
          contrats: readContracts(),
          resultats: readResults(),
          date: new Date().toISOString()
        };
        
        const dataStr = JSON.stringify(data, null, 2);
        const blob = new Blob([dataStr], {type: 'application/json'});
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `transmosca_backup_${new Date().toISOString().split('T')[0]}.json`;
        link.click();
        URL.revokeObjectURL(url);
        
        alert("Données sauvegardées avec succès !");
      }

      function importData(){
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'application/json';
        
        input.onchange = (e) => {
          const file = e.target.files[0];
          if(!file) return;
          
          const reader = new FileReader();
          reader.onload = (event) => {
            try {
              const data = JSON.parse(event.target.result);
              
              if(confirm(`Importer les données du ${new Date(data.date).toLocaleDateString('fr-FR')} ?\n\n` +
                        `- ${data.offres?.length || 0} offres\n` +
                        `- ${data.contrats?.length || 0} contrats\n` +
                        `- ${data.resultats?.length || 0} résultats\n\n` +
                        `ATTENTION: Cela remplacera toutes vos données actuelles !`)){
                
                if(data.offres) writeOffers(data.offres);
                if(data.contrats) writeContracts(data.contrats);
                if(data.resultats) writeResults(data.resultats);
                
                alert("Données importées avec succès !");
                renderOffers();
              }
            } catch(err) {
              alert("Erreur lors de l'import: " + err.message);
            }
          };
          reader.readAsText(file);
        };
        
        input.click();
      }

      function previewOffer(offer){
        const modal = document.createElement('div');
        modal.style.cssText = `
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(0,0,0,0.9);
          z-index: 10000;
          overflow: auto;
          padding: 20px;
        `;

        const content = document.createElement('div');
        content.style.cssText = `
          max-width: 900px;
          margin: 0 auto;
          background: white;
          padding: 40px;
          border-radius: 8px;
          box-shadow: 0 4px 20px rgba(0,0,0,0.3);
          position: relative;
        `;

        let html = `
          <div style="position: relative;">
            <button onclick="document.querySelector('[data-modal]').remove()" style="position: absolute; top: -10px; right: -10px; background: #ff4444; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-size: 14px; z-index: 10000; font-weight: bold;">✖ Fermer</button>
            
            <img src="transmosca.jpg" alt="Transmosca" style="position: absolute; top: 150px; left: 50%; transform: translateX(-50%); width: 400px; opacity: 0.08; z-index: 0;" onerror="this.style.display='none'">
            
            <div style="position: relative; z-index: 1; margin-top: 20px;">
              <div style="text-align: center; margin-bottom: 30px;">
                <h2 style="color: #333; margin: 10px 0;">S.P.R.L. TRANSMOSCA</h2>
                <p style="font-size: 12px; color: #666; line-height: 1.6;">
                  TRANSPORTS - TERRASSEMENTS - CONTAINERS - LOCATIONS<br>
                  GESTION GLOBALE DES DECHETS - TRI / VALORISATION<br>
                  Rue J. Stiernon, 20 - 7134 RESSAIX<br>
                  T.V.A. BE 0430.930.814 | Tel.: 064/36.96.98<br>
                  www.transmosca.be | info@transmosca.be
                </p>
              </div>
            </div>
          </div>

            <div style="display: flex; justify-content: space-between; margin-bottom: 30px; position: relative; z-index: 1;">
              <div style="flex: 1;"></div>
              <div style="flex: 1; text-align: right; font-size: 13px; color: #333;">
                <strong>CLIENT:</strong><br>
              ${offer.clientName || ''}<br>
              ${offer.etablissement ? offer.etablissement + '<br>' : ''}
              ${offer.adresse ? offer.adresse + '<br>' : ''}
              ${offer.tva ? 'TVA: ' + offer.tva + '<br>' : ''}
              ${offer.tel ? 'Tel: ' + offer.tel + '<br>' : ''}
                ${offer.email ? 'Email: ' + offer.email : ''}
              </div>
            </div>

            <h1 style="text-align: center; color: #333; margin: 40px 0 30px 0; font-size: 28px; position: relative; z-index: 1;">OFFRE DE PRIX</h1>

            <div style="margin: 30px 0; font-size: 14px; line-height: 1.8; color: #333; position: relative; z-index: 1;">
            <p><strong>Bonjour,</strong></p>
            <p>Suite a votre demande, voici l'offre de prix que vous avez sollicitee.</p>
            <p>Cette offre reste valable 14 jours.</p>
            <p>Nous restons a votre disposition pour tout renseignement complementaire.</p>
            
            <div style="margin: 20px 0;">
              <strong>Nos points forts :</strong>
              <ul style="margin: 10px 0; padding-left: 30px;">
                <li>Service de qualite</li>
                <li>Disponibilite</li>
                <li>Reactivite</li>
              </ul>
            </div>

            <table style="width: auto; border-collapse: collapse; font-size: 14px; margin: 0;">
              <tr>
                <td style="padding: 4px 20px 4px 0; border: none;"><strong>Numero d'offre:</strong></td>
                <td style="padding: 4px 0; border: none;">${offer.offerNumber}</td>
              </tr>
              <tr>
                <td style="padding: 4px 20px 4px 0; border: none;"><strong>Date:</strong></td>
                <td style="padding: 4px 0; border: none;">${offer.date}</td>
              </tr>
              ${offer.dureeContrat ? `<tr>
                <td style="padding: 4px 20px 4px 0; border: none;"><strong>Duree du contrat:</strong></td>
                <td style="padding: 4px 0; border: none;">${offer.dureeContrat} mois</td>
              </tr>` : ''}
            </table>
            </div>

            <hr style="border: none; border-top: 2px solid #333; margin: 40px 0; position: relative; z-index: 1;">

            <h2 style="text-align: center; color: #333; margin: 30px 0; position: relative; z-index: 1;">DETAILS DE L'OFFRE</h2>

            <div style="border: 2px solid #333; padding: 15px; margin: 20px 0; font-size: 13px; position: relative; z-index: 1; background: white;">
            <p><strong>Client:</strong> ${offer.clientName}</p>
            ${offer.etablissement ? `<p><strong>Etablissement:</strong> ${offer.etablissement}</p>` : ''}
            <p><strong>Adresse de prestation:</strong> ${offer.adressePresta || '-'}</p>
            <p><strong>Personne de contact:</strong> ${offer.contactName || '-'}, ${offer.contactPhone || '-'}</p>
              ${offer.remarks ? `<p><strong>Remarques:</strong> ${offer.remarks}</p>` : ''}
            </div>

            <h3 style="color: #333; margin: 30px 0 15px 0; position: relative; z-index: 1;">PRODUITS ET SERVICES</h3>
          </div>
        `;

        offer.lignes.forEach((ligne, i) => {
          html += `<div style="margin: 20px 0; border: 1px solid #ddd; border-radius: 5px; overflow: hidden; position: relative; z-index: 1; background: white;">`;
          
          if(ligne.type === 'poubelle'){
            html += `
              <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                <thead>
                  <tr style="background: #f5f5f5;">
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Type</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Dechet</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Taille</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Nb</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Location</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Vidange</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Max</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Surpoids</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td style="padding: 8px; border: 1px solid #ddd;">Poubelle</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.dechet || '-'}</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.modele || '-'}</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.nombre || '-'}</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.loc || '0'} EUR</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.vidange || '0'} EUR</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.max || '0'} kg</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.surpoids || '0'} EUR/kg</td>
                  </tr>
                </tbody>
              </table>
            `;
          } else if(ligne.type === 'conteneur'){
            if(ligne.mode === 'forfait'){
              html += `
                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                  <thead>
                    <tr style="background: #f5f5f5;">
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Type</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Dechet</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Taille</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Forfait</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Location</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Max</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Surpoids</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td style="padding: 8px; border: 1px solid #ddd;">Conteneur</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.dechet || '-'}</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.volume || '-'}</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.forfaitPrix || '0'} EUR</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.forfaitLoc || '0'} EUR</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.forfaitMax || '0'} kg</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.forfaitSurpoids || '0'} EUR/kg</td>
                    </tr>
                  </tbody>
                </table>
              `;
            } else {
              html += `
                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                  <thead>
                    <tr style="background: #f5f5f5;">
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Type</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Dechet</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Taille</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Transport</th>
                      <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Traitement/tonne</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td style="padding: 8px; border: 1px solid #ddd;">Conteneur</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.dechet || '-'}</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.volume || '-'}</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.poidsTransport || '0'} EUR</td>
                      <td style="padding: 8px; border: 1px solid #ddd;">${ligne.poidsTarif || '0'} EUR/T</td>
                    </tr>
                  </tbody>
                </table>
              `;
            }
          } else if(ligne.type === 'bigbag'){
            html += `
              <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                <thead>
                  <tr style="background: #f5f5f5;">
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Type</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Dechet</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Cout unitaire</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td style="padding: 8px; border: 1px solid #ddd;">Big Bag</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.dechet || '-'}</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.cost || '0'} EUR</td>
                  </tr>
                </tbody>
              </table>
            `;
          } else if(ligne.type === 'sac'){
            html += `
              <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                <thead>
                  <tr style="background: #f5f5f5;">
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Type</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Dechet</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Cout unitaire</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Max</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td style="padding: 8px; border: 1px solid #ddd;">Sac</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.dechet || '-'}</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.cost || '0'} EUR</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.max || '0'} kg</td>
                  </tr>
                </tbody>
              </table>
            `;
          } else {
            html += `
              <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                <thead>
                  <tr style="background: #f5f5f5;">
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Type</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Dechet</th>
                    <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Cout unitaire</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.type || '-'}</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.dechet || '-'}</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">${ligne.cost || '0'} EUR</td>
                  </tr>
                </tbody>
              </table>
            `;
          }
          
          html += `</div>`;
        });

        html += `
          <div style="margin-top: 50px; display: flex; justify-content: space-between; position: relative; z-index: 1;">
            <div>
              <p><strong>Signature Transmosca:</strong></p>
              <p style="margin-top: 30px;">Vincent Cousin<br>Sales Manager</p>
            </div>
            <div>
              <p><strong>Signature Client:</strong></p>
              <p style="margin-top: 30px;">Date:</p>
            </div>
          </div>
          </div>
        `;

        content.innerHTML = html;
        modal.appendChild(content);
        modal.setAttribute('data-modal', 'true');
        document.body.appendChild(modal);
        
        // Fermer aussi en cliquant sur le fond noir
        modal.addEventListener('click', (e) => {
          if(e.target === modal) modal.remove();
        });
      }

      const addLineBtn = document.getElementById("addLine");
      if(addLineBtn){
        addLineBtn.addEventListener('click', _addLineInternal);
      }

      const saveBtnEl = document.getElementById("saveOffer");
      if(saveBtnEl) saveBtnEl.addEventListener('click', saveOffer);
      document.getElementById("clearAll").onclick = () => {
        if(confirm("Supprimer TOUTES les offres ?")){
          writeOffers([]);
          renderOffers();
        }
      };

      // Recherche en temps réel
      const searchInput = document.getElementById("searchInput");
      searchInput.addEventListener("input", (e) => {
        renderOffers(e.target.value);
      });

      renderOffers();
    });
  </script>
</body>
</html>
